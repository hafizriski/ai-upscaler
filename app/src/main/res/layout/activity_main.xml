<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_bg">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/ios_bg"
        android:fitsSystemWindows="true"
        android:gravity="center_vertical"
        android:minHeight="@dimen/toolbar_height"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/sp_5"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvAppTitle"
            style="@style/IOS_LargeTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingVertical="@dimen/sp_2"
            android:text="@string/app_name"/>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/tabHome"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/sp_4"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/sp_5"
            android:paddingTop="@dimen/sp_3">

            <com.google.android.material.card.MaterialCardView
                style="@style/CardSurface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/preview_card_height">

                    <ImageView
                        android:id="@+id/imagePreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/ios_bg_secondary"
                        android:contentDescription="@string/cd_image_preview"
                        android:scaleType="fitCenter"/>

                    <include
                        layout="@layout/view_before_after"
                        android:visibility="gone"/>

                    <LinearLayout
                        android:id="@+id/previewPlaceholder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">
                        <ImageView
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:alpha="0.5"
                            android:contentDescription="@string/app_name"
                            android:src="@android:drawable/ic_menu_gallery"/>
                        <TextView
                            style="@style/IOS_Subheadline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sp_3"
                            android:text="@string/hint_pick_image"/>
                    </LinearLayout>

                    <View
                        android:id="@+id/progressScrim"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/overlay_scrim"
                        android:visibility="gone"/>

                    <LinearLayout
                        android:id="@+id/progressOverlay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone">
                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/circularProgress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:indeterminate="true"
                            app:indicatorColor="@color/ios_blue"
                            app:trackColor="@color/ios_bg_tertiary"/>
                        <TextView
                            android:id="@+id/tvOverlayPercent"
                            style="@style/IOS_Title3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sp_3"
                            android:textColor="@color/ios_blue"/>
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvInfo"
                style="@style/IOS_Caption1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_3"
                android:gravity="center"
                android:text="@string/hint_no_result"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpscale"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/sp_4"
                android:text="@string/action_upscale"
                android:textAllCaps="false"
                android:textColor="@color/ios_label"
                android:textSize="@dimen/ios_headline"
                android:textStyle="bold"
                android:visibility="gone"
                app:backgroundTint="@color/ios_blue"
                app:cornerRadius="@dimen/r_pill"
                app:elevation="0dp"
                app:icon="@android:drawable/ic_menu_edit"
                app:iconTint="@color/ios_label"/>

            <LinearLayout
                android:id="@+id/resultActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_3"
                android:orientation="horizontal"
                android:visibility="gone">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSave"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/sp_2"
                    android:text="@string/action_save"
                    android:textAllCaps="false"
                    android:textColor="@color/ios_blue"
                    android:textSize="@dimen/ios_headline"
                    android:textStyle="bold"
                    app:backgroundTint="@color/ios_fill_tertiary"
                    app:cornerRadius="@dimen/r_pill"
                    app:elevation="0dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShare"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_weight="1"
                    android:text="@string/action_share"
                    android:textAllCaps="false"
                    android:textColor="@color/ios_label"
                    android:textSize="@dimen/ios_headline"
                    android:textStyle="bold"
                    app:backgroundTint="@color/ios_blue"
                    app:cornerRadius="@dimen/r_pill"
                    app:elevation="0dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/emptyActionHint"
                style="@style/IOS_Caption1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_4"
                android:gravity="center"
                android:text="@string/hint_pick_first"/>

            <TextView
                style="@style/IOS_Footnote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_6"
                android:layout_marginStart="@dimen/sp_1"
                android:layout_marginBottom="@dimen/sp_2"
                android:text="@string/label_model"
                android:textAllCaps="true"/>

            <com.google.android.material.card.MaterialCardView
                style="@style/CardSurface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/sp_4">
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">
                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupModels"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipSpacingHorizontal="@dimen/sp_2"
                            app:singleLine="true"
                            app:singleSelection="true"
                            app:selectionRequired="true"/>
                    </HorizontalScrollView>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sp_3"
                        android:background="@drawable/bg_info_panel"
                        android:orientation="vertical"
                        android:padding="@dimen/sp_3">
                        <TextView
                            android:id="@+id/tvModelName"
                            style="@style/IOS_Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:text="—"/>
                        <TextView
                            android:id="@+id/tvModelDesc"
                            style="@style/IOS_Caption1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="—"/>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sp_2"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/chipScale"
                                style="@style/IOS_Caption2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_info_panel"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:text="×4"/>
                            <TextView
                                android:id="@+id/chipSize"
                                style="@style/IOS_Caption2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/sp_1"
                                android:background="@drawable/bg_info_panel"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:text="— MB"/>
                            <TextView
                                android:id="@+id/chipSpeed"
                                style="@style/IOS_Caption2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/sp_1"
                                android:background="@drawable/bg_info_panel"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:text="—"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/IOS_Footnote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_6"
                android:layout_marginStart="@dimen/sp_1"
                android:layout_marginBottom="@dimen/sp_2"
                android:text="STATUS"
                android:textAllCaps="true"/>

            <com.google.android.material.card.MaterialCardView
                style="@style/CardSurface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/sp_4">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <View
                            android:id="@+id/statusDot"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/dot_idle"/>
                        <TextView
                            android:id="@+id/tvStatus"
                            style="@style/IOS_Headline"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/sp_2"
                            android:layout_weight="1"
                            android:text="@string/status_idle"/>
                        <TextView
                            android:id="@+id/tvPercent"
                            style="@style/IOS_Callout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textColor="@color/ios_blue"
                            android:textStyle="bold"/>
                    </LinearLayout>
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/linearProgress"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_marginTop="@dimen/sp_3"
                        android:visibility="invisible"
                        app:indicatorColor="@color/ios_blue"
                        app:trackColor="@color/ios_bg_tertiary"
                        app:trackCornerRadius="2dp"
                        app:trackThickness="3dp"/>
                    <TextView
                        android:id="@+id/tvProgress"
                        style="@style/IOS_Caption2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sp_2"
                        android:fontFamily="monospace"
                        android:text="Menunggu…"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCancel"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="@dimen/sp_3"
                        android:text="@string/action_cancel"
                        android:textAllCaps="false"
                        android:textColor="@color/ios_red"
                        android:visibility="gone"/>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="@dimen/sp_4"
                        android:background="@color/ios_separator"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            style="@style/IOS_Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_threads"/>
                        <TextView
                            android:id="@+id/tvThreadCount"
                            style="@style/IOS_Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textColor="@color/ios_blue"
                            android:textStyle="bold"
                            android:text="8"/>
                    </LinearLayout>
                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderThreads"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="1"
                        android:value="8"
                        android:valueFrom="1"
                        android:valueTo="8"
                        app:haloColor="@color/ios_blue"
                        app:labelBehavior="gone"
                        app:thumbColor="@color/ios_blue"
                        app:trackColorActive="@color/ios_blue"
                        app:trackColorInactive="@color/ios_bg_tertiary"/>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="@dimen/sp_4"
                        android:background="@color/ios_separator"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/IOS_Caption2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_cpu"
                                android:textAllCaps="true"/>
                            <TextView
                                android:id="@+id/tvCpu"
                                style="@style/IOS_Footnote"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="monospace"
                                android:text="—"
                                android:textColor="@color/ios_label"
                                android:textStyle="bold"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/IOS_Caption2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_ram"
                                android:textAllCaps="true"/>
                            <TextView
                                android:id="@+id/tvRam"
                                style="@style/IOS_Footnote"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="monospace"
                                android:text="—"
                                android:textColor="@color/ios_label"
                                android:textStyle="bold"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/IOS_Caption2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_gpu"
                                android:textAllCaps="true"/>
                            <TextView
                                android:id="@+id/tvGpu"
                                style="@style/IOS_Footnote"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="monospace"
                                android:text="—"
                                android:textColor="@color/ios_label"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvVulkan"
                        style="@style/IOS_Caption2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sp_3"
                        android:fontFamily="monospace"
                        android:text="Vulkan: —"/>
                    <LinearLayout
                        android:id="@+id/logHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sp_4"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/sp_2">
                        <TextView
                            style="@style/IOS_Footnote"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_detail"
                            android:textColor="@color/ios_blue"/>
                        <TextView
                            android:id="@+id/logChevron"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▸"
                            android:textColor="@color/ios_blue"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvLog"
                        style="@style/IOS_Caption2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/ios_bg"
                        android:fontFamily="monospace"
                        android:maxLines="14"
                        android:padding="@dimen/sp_2"
                        android:text=""
                        android:visibility="gone"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/IOS_Caption2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_8"
                android:layout_marginBottom="@dimen/sp_10"
                android:alpha="0.5"
                android:gravity="center"
                android:text="@string/developer_info"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/tabGallery"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingHorizontal="@dimen/sp_4"
        android:paddingTop="@dimen/sp_4"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            style="@style/IOS_Footnote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/sp_1"
            android:text="@string/gallery_title"
            android:textAllCaps="true"/>
        <TextView
            android:id="@+id/tvGalleryCount"
            style="@style/IOS_Caption1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_1"
            android:layout_marginStart="@dimen/sp_1"
            android:text="0 item"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGallery"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/sp_4"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/sp_4"/>
        <LinearLayout
            android:id="@+id/galleryEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">
            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:alpha="0.3"
                android:src="@android:drawable/ic_menu_gallery"
                app:tint="@color/ios_label_secondary"/>
            <TextView
                style="@style/IOS_Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_3"
                android:text="@string/gallery_empty"
                android:textColor="@color/ios_label_secondary"/>
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/tabProfile"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:visibility="gone"
        android:paddingHorizontal="@dimen/sp_5"
        android:paddingTop="@dimen/sp_6"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <FrameLayout
                android:id="@+id/avatarContainer"
                android:layout_width="@dimen/profile_avatar"
                android:layout_height="@dimen/profile_avatar"
                android:layout_marginTop="@dimen/sp_4"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/ivProfilePhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_avatar"
                    android:contentDescription="@string/cd_profile_photo"
                    android:scaleType="centerCrop"/>
                <ImageView
                    android:id="@+id/ivProfilePhotoDefault"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="32dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    app:tint="@color/ios_label_secondary"/>
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_edit_fab"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_edit"
                    app:tint="@color/ios_label"/>
            </FrameLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilUsername"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_8"
                android:hint="@string/label_username"
                app:boxStrokeColor="@color/ios_blue"
                app:hintTextColor="@color/ios_label_secondary">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_username"
                    android:inputType="textPersonName"
                    android:maxLines="1"
                    android:textColor="@color/ios_label"
                    android:textSize="@dimen/ios_body"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveProfile"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/sp_4"
                android:text="@string/action_save_profile"
                android:textAllCaps="false"
                android:textColor="@color/ios_label"
                android:textSize="@dimen/ios_headline"
                android:textStyle="bold"
                app:backgroundTint="@color/ios_blue"
                app:cornerRadius="@dimen/r_pill"
                app:elevation="0dp"/>

            <TextView
                style="@style/IOS_Caption2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_10"
                android:layout_marginBottom="@dimen/sp_10"
                android:alpha="0.5"
                android:gravity="center"
                android:text="@string/developer_info"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/sp_4"
        android:text="@string/action_add"
        android:textAllCaps="false"
        android:textColor="@color/ios_label"
        android:textSize="@dimen/ios_headline"
        android:textStyle="bold"
        app:backgroundTint="@color/ios_blue"
        app:cornerRadius="@dimen/r_pill"
        app:elevation="0dp"
        app:icon="@android:drawable/ic_menu_camera"
        app:iconTint="@color/ios_label"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_nav"
        android:elevation="8dp"
        android:fitsSystemWindows="true"
        android:orientation="horizontal"
        android:paddingTop="@dimen/sp_2"
        android:paddingBottom="@dimen/sp_3"
        android:weightSum="3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="@dimen/sp_1">
            <ImageView
                android:id="@+id/ivNavHome"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_gallery"
                app:tint="@color/ios_blue"/>
            <TextView
                android:id="@+id/tvNavHome"
                style="@style/IOS_Caption2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_home"
                android:textColor="@color/ios_blue"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navGallery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="@dimen/sp_1">
            <ImageView
                android:id="@+id/ivNavGallery"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="@color/ios_label_secondary"/>
            <TextView
                android:id="@+id/tvNavGallery"
                style="@style/IOS_Caption2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_gallery"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="@dimen/sp_1">
            <ImageView
                android:id="@+id/ivNavProfile"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="@color/ios_label_secondary"/>
            <TextView
                android:id="@+id/tvNavProfile"
                style="@style/IOS_Caption2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_profile"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
